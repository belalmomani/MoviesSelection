<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Google Play forbids apps from installing/updating themselves outside Play: removed from release (store) builds. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />

    <!-- Used instead of src/release when ADS_ENABLED=false: no ad SDK is built in, so the advertising-ID permission is dropped
         (the Play Console "Advertising ID" answer must then be "No"). -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
</manifest>
